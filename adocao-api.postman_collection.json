              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animais",
                "{{idInexistente}}"
              ]
            },
            "description": "Retorna `404 Not Found`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Luna Atualizada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
