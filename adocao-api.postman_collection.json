                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/animais/{{idInexistente}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animais",
                "{{idInexistente}}"
              ]
            },
            "description": "Usa um ID inexistente de propósito: a validação ocorre antes da busca, então retorna `400 Bad Request`.",
            "body": {
